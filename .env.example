# ==============================================
# Hermes AGY ACP Environment Configuration Template
# Copy to .env and customize. NEVER commit .env!
# ==============================================

# Antigravity CLI and ACP Server Paths (leave empty for auto-discovery via PATH)
AGY_CLI_PATH=
AGY_ACP_SERVER_PATH=

# ACP Process Execution Flags
AGY_ACP_ARGS=--uid=

# Default Model Selection
# Options: gemini-3.8-flash-high, gemini-4-argon-high, gemini-3.8-flash-medium
AGY_DEFAULT_MODEL=gemini-3.8-flash-high

# Thinking / Reasoning Budget (low, medium, high)
AGY_THINKING_LEVEL=high

# Logging & Diagnostic Verbosity (error, warn, info, debug)
AGY_LOG_LEVEL=warn
